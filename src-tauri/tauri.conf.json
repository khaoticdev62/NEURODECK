{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neurodeck",
  "version": "1.4.0",
  "identifier": "com.neurodeck.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run --prefix frontend dev",
    "beforeBuildCommand": "npm run --prefix frontend build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEURODECK",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "title": "Booting...",
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 640,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://fonts.gstatic.com https://fonts.googleapis.com; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: data: blob: https://lh3.googleusercontent.com https://generativelanguage.googleapis.com http://localhost:11434 http://127.0.0.1:11434; font-src 'self' asset: data: https://fonts.gstatic.com; connect-src 'self' ipc: http://localhost:1420 http://localhost:11434 http://127.0.0.1:11434 ws://localhost:1420 https://generativelanguage.googleapis.com https://oauth2.googleapis.com https://fonts.googleapis.com https://api-inference.huggingface.co; media-src 'self' asset: data: blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/bmad.lua": "plugins/bmad.lua",
      "../plugins/promptgen.lua": "plugins/promptgen.lua",
      "../plugins/ip_lookup.lua": "plugins/ip_lookup.lua",
      "../plugins/auto_responder.lua": "plugins/auto_responder.lua",
      "llm-term.toml": "llm-term.toml",
      "../assets/bmad-bundle/**/*": "bmad-bundle",
      "../assets/boot-pipeline.json": "boot-pipeline.json",
      "../assets/boot-pipeline.schema.json": "boot-pipeline.schema.json"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "wix": {
        "template": "wix.template.wxs"
      }
    }
  }
}
