{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neurodeck",
  "version": "1.2.1",
  "identifier": "com.neurodeck.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run --prefix frontend dev",
    "beforeBuildCommand": "npm run --prefix frontend build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEURODECK",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "title": "Booting...",
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 640,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/bmad.lua": "plugins/bmad.lua",
      "../plugins/promptgen.lua": "plugins/promptgen.lua",
      "../plugins/ip_lookup.lua": "plugins/ip_lookup.lua",
      "../plugins/auto_responder.lua": "plugins/auto_responder.lua",
      "llm-term.toml": "llm-term.toml",
      "../assets/bmad-bundle/**/*": "bmad-bundle"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
