{
  "name": "neurodeck",
  "version": "1.8.0",
  "description": "AI-native terminal OS for Steam Deck — Electron + Rust + Gemini",
  "main": "electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Khaotic Labs <dev@khaoticlabs.com>",
  "workspaces": [
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev:autokill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/powershell/dev-autokill.ps1",
    "build:main": "npx esbuild \"src/**/*.ts\" --platform=node --format=cjs --outdir=electron/dist --outbase=src",
    "dev": "npm run build:main && npm run dev:autokill && node electron/scripts/dev-launcher.js",
    "dev:no-sidecar": "node electron/scripts/dev-launcher.js",
    "build": "node scripts/brand/validate-design-system.js && npm run frontend:build && npm run sidecar:build && npm run build:main && npx electron-builder --config electron-builder.yml --projectDir .",
    "build:linux": "bash scripts/steamdeck/package-steamdeck.sh --target linux",
    "sidecar:build": "cd src-tauri && cargo build --release",
    "frontend:dev": "npm -w frontend run dev",
    "frontend:build": "npm -w frontend run build",
    "frontend:preview": "npm -w frontend run preview",
    "frontend:typecheck": "npm -w frontend run typecheck",
    "frontend:test": "bash -c \"cd frontend && node ../node_modules/vitest/dist/cli.js run\"",
    "storybook": "npm -w frontend run storybook",
    "build-storybook": "npm -w frontend run build-storybook",
    "chromatic": "npm -w frontend run chromatic",
    "rust:check": "cargo check",
    "rust:clippy": "cargo clippy",
    "rust:build": "cargo build",
    "rust:test": "cargo test",
    "rust:fmt": "cargo fmt --all",
    "ci": "bash scripts/kfms/kfms-ci.sh run",
    "ci:lint": "bash scripts/kfms/kfms-ci.sh lint",
    "ci:test": "bash scripts/kfms/kfms-ci.sh test",
    "ci:build": "bash scripts/kfms/kfms-ci.sh build",
    "ci:security": "bash scripts/kfms/kfms-ci.sh security",
    "ci:watch": "bash scripts/kfms/kfms-ci.sh watch",
    "ci:status": "bash scripts/kfms/kfms-ci.sh status",
    "preflight": "bash scripts/git/preflight.sh",
    "git:install-hooks": "bash scripts/git/install-hooks.sh",
    "git:agent-guard": "bash scripts/git/agent-commit-guard.sh",
    "checkpoint:ui": "bash scripts/ui/checkpoint-ui.sh",
    "checkpoint:ui:force": "bash scripts/ui/checkpoint-ui.sh --force",
    "rollback:ui:latest": "bash scripts/ui/rollback-ui.sh latest",
    "rollback:ui:preview": "bash scripts/ui/rollback-ui.sh preview",
    "rollback:ui:apply": "bash scripts/ui/rollback-ui.sh apply",
    "rollback:ui:list": "bash scripts/ui/list-checkpoints.sh",
    "release:manifest": "node scripts/release/generate-release-manifest.mjs",
    "assets": "python assets/brand/generate_assets.py",
    "brand:generate": "node scripts/brand/generate-brand-assets.mjs",
    "brand:validate": "node scripts/brand/validate-brand-assets.mjs",
    "brand:build": "npm run brand:generate && npm run brand:validate",
    "setup": "npm install && echo \"\\nAll JS/Node deps installed. Next: uv sync (Python tooling) — then set GEMINI_API_KEY and run: npm run dev\"",
    "quality:fallow:audit": "node scripts/dev/run-fallow-if-available.js audit",
    "quality:fallow:json": "node scripts/dev/run-fallow-if-available.js audit --format json",
    "quality:fallow:health": "node scripts/dev/run-fallow-if-available.js health --score --hotspots --targets",
    "quality:fallow:dead-code": "node scripts/dev/run-fallow-if-available.js dead-code",
    "quality:fallow:dupes": "node scripts/dev/run-fallow-if-available.js dupes",
    "promptflow:init": "python -m promptflow init --force",
    "promptflow:list": "python -m promptflow list-prompts",
    "promptflow:inspect": "python -m promptflow inspect-repo --repo .",
    "promptflow:audit": "python -m promptflow run --sequence audit-only --provider manual",
    "promptflow:security": "python -m promptflow run --sequence security --provider manual",
    "promptflow:refactor": "python -m promptflow run --sequence refactor --provider manual",
    "promptflow:frontend": "python -m promptflow run --sequence frontend --provider manual",
    "promptflow:build": "python -m promptflow run --sequence build-repair --provider manual",
    "promptflow:release": "python -m promptflow run --sequence release-certification --provider manual",
    "promptflow:full": "python -m promptflow run --sequence full --provider manual",
    "promptflow:report": "python -m promptflow report --run-id latest",
    "promptflow:export": "python -m promptflow export --run-id latest",
    "promptflow:clean": "python -m promptflow clean --keep 5",
    "verify:wiring": "npm run build:main && tsx scripts/verify/verify-wiring.ts",
    "verify:ipc": "npm run build:main && tsx scripts/verify/verify-ipc.ts",
    "verify:lsp": "tsx scripts/verify/verify-lsp.ts",
    "verify:no-mocks": "tsx scripts/verify/verify-no-mocks.ts",
    "verify:security": "tsx scripts/verify/verify-backend-security.ts",
    "verify:real-data": "tsx scripts/verify/verify-real-data.ts",
    "verify:backend": "tsx scripts/verify/verify-backend.ts",
    "verify:model-support": "tsx scripts/verify/verify-model-support.ts",
    "verify:report": "tsx scripts/report/export-backend-readiness-report.ts",
    "verify:all": "npm run verify:no-mocks && npm run verify:security && npm run verify:real-data && npm run test:backend:contracts",
    "verify:ai-chat": "tsx scripts/verify/verify-ai-chat.ts",
    "verify:agent-selection": "tsx scripts/verify/verify-agent-selection.ts",
    "verify:no-mock-chat": "tsx scripts/verify/verify-no-mock-chat.ts",
    "verify:chat-security": "tsx scripts/verify/verify-chat-security.ts",
    "verify:no-tauri": "tsx scripts/verify/verify-no-tauri.ts",
    "verify:no-dead-code": "tsx scripts/verify/verify-no-dead-code.ts",
    "verify:no-production-mocks": "tsx scripts/verify/verify-no-production-mocks.ts",
    "verify:electron-replacements": "tsx scripts/verify/verify-electron-replacements.ts",
    "verify:architecture-boundaries": "tsx scripts/verify/verify-architecture-boundaries.ts",
    "production:cleanup-gate": "npm run verify:no-tauri && npm run verify:no-dead-code && npm run verify:no-production-mocks && npm run verify:electron-replacements && npm run verify:architecture-boundaries",
    "report:chat": "tsx scripts/report/export-chat-readiness-report.ts",
    "test:backend:contracts": "vitest run tests/contract/",
    "test:backend:integration": "vitest run tests/integration/",
    "test:backend": "vitest run tests/contract/ tests/integration/",
    "test:controller": "npm -w frontend run test -- src/react/__tests__/controller src/react/__tests__/features/OnboardingWizard.test.tsx",
    "test:unit": "vitest run tests/unit/",
    "test:unit:ide": "vitest run tests/unit/ide/ tests/unit/controller/",
    "test:integration:ide": "vitest run tests/integration/ide/",
    "test:ide": "vitest run tests/unit/ide/ tests/unit/controller/ tests/integration/ide/",
    "test:all": "vitest run tests/",
    "test:watch": "vitest watch tests/",
    "production:gate": "npm run verify:wiring && npm run verify:ipc && npm run verify:lsp && npm run verify:all",
    "production:chat-gate": "npm run verify:ai-chat && npm run verify:agent-selection && npm run verify:no-mock-chat && npm run verify:chat-security && npm run report:chat",
    "verify:language-commands": "tsx scripts/verify/verify-language-commands.ts",
    "verify:controller-coding": "tsx scripts/verify/verify-controller-coding.ts",
    "verify:predictive-snippets": "tsx scripts/verify/verify-predictive-snippets.ts",
    "verify:lsp-ide": "tsx scripts/verify/verify-lsp-ide-support.ts",
    "verify:safe-commands": "tsx scripts/verify/verify-safe-command-execution.ts",
    "verify:no-mock-ide": "tsx scripts/verify/verify-no-mock-ide-data.ts",
    "verify:all-ide": "npm run verify:no-mock-ide && npm run verify:language-commands && npm run verify:controller-coding && npm run verify:predictive-snippets && npm run verify:lsp-ide && npm run verify:safe-commands",
    "report:ide": "tsx scripts/report/export-ide-readiness-report.ts",
    "report:backend": "tsx scripts/report/export-backend-readiness-report.ts",
    "report:all": "npm run report:ide && npm run report:backend && npm run report:chat",
    "production:ide-gate": "npm run frontend:typecheck && npm run verify:all-ide && npm run test:ide && npm run report:ide",
    "verify:theme-system": "tsx scripts/verify/verify-theme-system.ts",
    "verify:theme-tokens": "tsx scripts/verify/verify-theme-tokens.ts",
    "verify:theme-token-usage": "tsx scripts/verify/verify-theme-token-usage.ts",
    "verify:theme-accessibility": "tsx scripts/verify/verify-theme-accessibility.ts",
    "verify:theme-performance": "tsx scripts/verify/verify-theme-performance.ts",
    "verify:live-wallpapers": "tsx scripts/verify/verify-live-wallpapers.ts",
    "verify:no-mock-theme-data": "tsx scripts/verify/verify-no-mock-theme-data.ts",
    "report:theme": "tsx scripts/report/export-theme-readiness-report.ts",
    "production:theme-gate": "npm run verify:theme-system && npm run verify:theme-tokens && npm run verify:theme-token-usage && npm run verify:theme-accessibility && npm run verify:theme-performance && npm run verify:live-wallpapers && npm run verify:no-mock-theme-data && npm run report:theme",
    "verify:browser-tabs": "tsx scripts/verify/verify-browser-tabs.ts",
    "verify:browser-security": "tsx scripts/verify/verify-browser-security.ts",
    "verify:browser-sessions": "tsx scripts/verify/verify-browser-sessions.ts",
    "verify:browser-downloads": "tsx scripts/verify/verify-browser-downloads.ts",
    "verify:no-mock-browser": "tsx scripts/verify/verify-no-mock-browser-data.ts",
    "report:browser": "tsx scripts/report/export-browser-readiness-report.ts",
    "production:browser-gate": "npm run verify:browser-tabs && npm run verify:browser-security && npm run verify:browser-sessions && npm run verify:browser-downloads && npm run verify:no-mock-browser && npm run report:browser",
    "verify:terminal-system": "tsx scripts/verify/verify-terminal-system.ts",
    "verify:pty-sessions": "tsx scripts/verify/verify-pty-sessions.ts",
    "verify:terminal-security": "tsx scripts/verify/verify-terminal-security.ts",
    "verify:terminal-no-mocks": "tsx scripts/verify/verify-terminal-no-mocks.ts",
    "verify:terminal-controller": "tsx scripts/verify/verify-terminal-controller-ux.ts",
    "verify:terminal-command-policy": "tsx scripts/verify/verify-terminal-command-policy.ts",
    "verify:terminal-self-healing": "tsx scripts/verify/verify-terminal-self-healing.ts",
    "verify:terminal-profiles": "tsx scripts/verify/verify-terminal-profiles.ts",
    "verify:terminal-history": "tsx scripts/verify/verify-terminal-history.ts",
    "verify:terminal-ai-assist": "tsx scripts/verify/verify-terminal-ai-assist.ts",
    "report:terminal": "tsx scripts/report/export-terminal-readiness-report.ts",
    "production:terminal-gate": "npm run verify:terminal-no-mocks && npm run verify:terminal-security && npm run verify:terminal-system && npm run verify:pty-sessions && npm run verify:terminal-command-policy && npm run verify:terminal-profiles && npm run verify:terminal-history && npm run verify:terminal-ai-assist && npm run verify:terminal-controller && npm run verify:terminal-self-healing && npm run report:terminal",
    "check:steamdeck-deps": "bash scripts/steamdeck/check-feature-dependencies.sh",
    "check:installer": "bash scripts/steamdeck/validate-installer.sh",
    "package:steamdeck": "bash scripts/steamdeck/package-steamdeck.sh --target all",
    "validate:steamdeck-package": "bash scripts/steamdeck/validate-installer.sh",
    "validate:proton-package": "bash scripts/steamdeck/validate-proton.sh",
    "check:focus-graphs": "node scripts/dev/check-focus-graphs.cjs",
    "check:controller-actions": "node scripts/dev/check-controller-actions.cjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/react-dom": "^19.2.3",
    "electron": "39.8.5",
    "electron-builder": "26.15.3",
    "fallow": "^2.98.0",
    "sharp": "^0.35.1",
    "tsx": "^4.19.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
