<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- App Sandbox disabled — NEURODECK requires direct filesystem and network access -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- JIT required for the Rust sidecar's Lua 5.4 vendored runtime (mlua) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Unsigned executable memory needed for the xterm.js canvas renderer -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Network client: LAN P2P, Warpinator gRPC, Ollama, remote control -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Network server: bridge HTTP server, canvas collab TCP, Warpinator gRPC -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Audio: voice recording (PTT/STT) via cpal -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
