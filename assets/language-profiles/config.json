      },
      "snippets": [
        {
          "id": "yaml.mapping",
          "languageId": "yaml",
          "label": "key: value",
          "description": "YAML key-value pair",
          "triggerContexts": ["block"],
          "insertText": "${1:key}: ${2:value}",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "name" },
            { "index": 2, "label": "value", "defaultValue": "value" }
