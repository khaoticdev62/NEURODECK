          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "yaml.list",
          "languageId": "yaml",
          "label": "list",
          "description": "YAML list items",
          "triggerContexts": ["block"],
          "insertText": "${1:key}:\n  - ${2:item1}\n  - ${3:item2}",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "items" },
            { "index": 2, "label": "item1", "defaultValue": "item1" },
            { "index": 3, "label": "item2", "defaultValue": "item2" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "yaml.multiline",
          "languageId": "yaml",
          "label": "multiline |",
          "description": "YAML literal block scalar",
          "triggerContexts": ["block"],
          "insertText": "${1:key}: |\n  ${2:line1}\n  ${3:line2}",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "text" },
            { "index": 2, "label": "line1", "defaultValue": "First line" },
            { "index": 3, "label": "line2", "defaultValue": "Second line" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "yaml.anchor",
          "languageId": "yaml",
          "label": "&anchor / *alias",
          "description": "YAML anchor and alias",
          "triggerContexts": ["block"],
          "insertText": "${1:base}: &${2:anchor}\n  ${3:key}: ${4:value}\n\n${5:derived}:\n  <<: *${2:anchor}",
          "placeholders": [
            { "index": 1, "label": "base", "defaultValue": "base" },
            { "index": 2, "label": "anchor", "defaultValue": "anchor" },
            { "index": 3, "label": "key", "defaultValue": "key" },
            { "index": 4, "label": "value", "defaultValue": "value" },
            { "index": 5, "label": "derived", "defaultValue": "derived" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "yaml.env-var",
          "languageId": "yaml",
          "label": "env var",
          "description": "Environment variable reference",
          "triggerContexts": ["value"],
          "insertText": "${1:key}: \"$${2:ENV_VAR}\"",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "value" },
            { "index": 2, "label": "env", "defaultValue": "MY_ENV" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        }
      ],
      "safety": {
        "allowRunByDefault": true,
        "requiresConfirmation": [],
        "blockedCommands": []
      }
    },
