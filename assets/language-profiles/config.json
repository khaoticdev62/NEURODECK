{
  "version": "1.0.0",
  "updatedAt": "2026-06-12",
  "profiles": [
    {
      "id": "json",
      "displayName": "JSON",
      "fileExtensions": [".json", ".jsonc", ".json5"],
      "configFiles": [".prettierrc", "prettier.config.js"],
      "lsp": {
        "serverId": "vscode-json-language-server",
        "serverCommand": "vscode-json-language-server",
        "serverArgs": ["--stdio"],
        "installHint": "npm install -g vscode-langservers-extracted",
        "supportsCompletion": true,
        "supportsHover": true,
        "supportsDefinition": false,
        "supportsFormatting": true,
        "supportsDiagnostics": true,
        "supportsCodeActions": false
      },
      "commands": {
        "format": [
          {
            "id": "json.prettier",
            "label": "Prettier (file)",
            "languageId": "json",
            "command": "npx",
            "args": ["prettier", "--write", "${file}"],
            "cwdStrategy": "fileDirectory",
            "appliesWhen": { "configFilesAny": [".prettierrc", "prettier.config.js"] },
            "safety": "safe",
            "description": "Format JSON with Prettier"
          },
          {
            "id": "json.python-tool",
            "label": "python json.tool",
            "languageId": "json",
            "command": "python3",
            "args": ["-m", "json.tool", "${file}"],
            "cwdStrategy": "fileDirectory",
            "appliesWhen": { "fileExtensions": [".json"] },
            "safety": "safe",
            "description": "Validate and pretty-print JSON with Python"
          }
        ]
      },
      "snippets": [
        {
          "id": "json.object",
          "languageId": "json",
          "label": "object",
          "description": "JSON object with key-value",
          "triggerContexts": ["value"],
          "insertText": "{\n  \"${1:key}\": \"${2:value}\"\n}",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "name" },
            { "index": 2, "label": "value", "defaultValue": "value" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "json.array",
          "languageId": "json",
          "label": "array",
          "description": "JSON array",
          "triggerContexts": ["value"],
          "insertText": "[\n  \"${1:item1}\",\n  \"${2:item2}\"\n]",
          "placeholders": [
            { "index": 1, "label": "item1", "defaultValue": "item1" },
            { "index": 2, "label": "item2", "defaultValue": "item2" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "json.string-field",
          "languageId": "json",
          "label": "\"key\": \"value\"",
          "description": "String field",
          "triggerContexts": ["object"],
          "insertText": "\"${1:key}\": \"${2:value}\"",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "field" },
            { "index": 2, "label": "value", "defaultValue": "" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "json.bool-field",
          "languageId": "json",
          "label": "\"key\": true",
          "description": "Boolean field",
          "triggerContexts": ["object"],
          "insertText": "\"${1:enabled}\": ${2:true}",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "enabled" },
            { "index": 2, "label": "value", "defaultValue": "true" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        }
      ],
      "safety": {
        "allowRunByDefault": true,
        "requiresConfirmation": [],
        "blockedCommands": []
      }
    },
    {
