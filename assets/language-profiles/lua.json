{
  "version": "1.0.0",
  "updatedAt": "2026-06-12",
  "profiles": [
    {
      "id": "lua",
      "displayName": "Lua",
      "fileExtensions": [".lua"],
      "configFiles": [".luacheckrc", "luacheckrc", "selene.toml", "stylua.toml", ".stylua.toml"],
      "lsp": {
        "serverId": "lua-language-server",
        "serverCommand": "lua-language-server",
        "serverArgs": [],
        "installHint": "Download from https://github.com/LuaLS/lua-language-server/releases",
        "supportsCompletion": true,
        "supportsHover": true,
        "supportsDefinition": true,
        "supportsFormatting": false,
        "supportsDiagnostics": true,
        "supportsCodeActions": false
      },
      "commands": {
        "runFile": [
          {
            "id": "lua.run",
            "label": "lua <file>",
            "languageId": "lua",
            "command": "lua",
            "args": ["${file}"],
            "cwdStrategy": "fileDirectory",
            "appliesWhen": { "fileExtensions": [".lua"] },
            "safety": "safe",
            "description": "Run Lua file"
          },
          {
            "id": "lua.run-luajit",
            "label": "luajit <file>",
            "languageId": "lua",
            "command": "luajit",
            "args": ["${file}"],
            "cwdStrategy": "fileDirectory",
            "appliesWhen": { "fileExtensions": [".lua"], "commandsAvailable": ["luajit"] },
            "safety": "safe",
            "description": "Run Lua file with LuaJIT"
          }
        ],
        "lint": [
          {
            "id": "lua.luacheck",
            "label": "luacheck .",
            "languageId": "lua",
            "command": "luacheck",
            "args": ["."],
            "cwdStrategy": "workspaceRoot",
            "appliesWhen": { "configFilesAny": [".luacheckrc", "luacheckrc"], "commandsAvailable": ["luacheck"] },
            "safety": "safe",
            "description": "Static analysis with luacheck"
          }
        ],
        "format": [
          {
            "id": "lua.stylua",
            "label": "stylua .",
            "languageId": "lua",
            "command": "stylua",
            "args": ["."],
            "cwdStrategy": "workspaceRoot",
            "appliesWhen": { "configFilesAny": ["stylua.toml", ".stylua.toml"], "commandsAvailable": ["stylua"] },
            "safety": "safe",
            "description": "Format Lua code with StyLua"
          }
        ],
        "testProject": [
          {
            "id": "lua.busted",
            "label": "busted",
            "languageId": "lua",
            "command": "busted",
            "args": [],
            "cwdStrategy": "workspaceRoot",
            "appliesWhen": { "commandsAvailable": ["busted"] },
            "safety": "safe",
            "description": "Run tests with busted"
          }
        ]
      },
      "snippets": [
        {
          "id": "lua.function",
          "languageId": "lua",
          "label": "function",
          "description": "Lua function",
          "triggerContexts": ["toplevel"],
          "insertText": "local function ${1:name}(${2:params})\n  ${3:-- body}\nend",
          "placeholders": [
            { "index": 1, "label": "name", "defaultValue": "myFunction" },
            { "index": 2, "label": "params", "defaultValue": "" },
            { "index": 3, "label": "body", "defaultValue": "-- body" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.if",
          "languageId": "lua",
          "label": "if",
          "description": "If statement",
          "triggerContexts": ["block"],
          "insertText": "if ${1:condition} then\n  ${2:-- body}\nend",
          "placeholders": [
            { "index": 1, "label": "condition", "defaultValue": "true" },
            { "index": 2, "label": "body", "defaultValue": "" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.for-ipairs",
          "languageId": "lua",
          "label": "for ipairs",
          "description": "Array iteration",
          "triggerContexts": ["block"],
          "insertText": "for ${1:i}, ${2:v} in ipairs(${3:t}) do\n  ${4:-- body}\nend",
          "placeholders": [
            { "index": 1, "label": "index", "defaultValue": "i" },
            { "index": 2, "label": "value", "defaultValue": "v" },
            { "index": 3, "label": "table", "defaultValue": "t" },
            { "index": 4, "label": "body", "defaultValue": "" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.for-pairs",
          "languageId": "lua",
          "label": "for pairs",
          "description": "Table iteration",
          "triggerContexts": ["block"],
          "insertText": "for ${1:k}, ${2:v} in pairs(${3:t}) do\n  ${4:-- body}\nend",
          "placeholders": [
            { "index": 1, "label": "key", "defaultValue": "k" },
            { "index": 2, "label": "value", "defaultValue": "v" },
            { "index": 3, "label": "table", "defaultValue": "t" },
            { "index": 4, "label": "body", "defaultValue": "" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.pcall",
          "languageId": "lua",
          "label": "pcall",
          "description": "Protected call (error handling)",
          "triggerContexts": ["block"],
          "insertText": "local ok, ${1:err} = pcall(${2:fn})\nif not ok then\n  print('Error:', ${1:err})\nend",
          "placeholders": [
            { "index": 1, "label": "err", "defaultValue": "err" },
            { "index": 2, "label": "function", "defaultValue": "risky_function" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.module",
          "languageId": "lua",
          "label": "module",
          "description": "Lua module pattern",
          "triggerContexts": ["toplevel"],
          "insertText": "local M = {}\n\nfunction M.${1:method}(${2:params})\n  ${3:-- body}\nend\n\nreturn M",
          "placeholders": [
            { "index": 1, "label": "method", "defaultValue": "new" },
            { "index": 2, "label": "params", "defaultValue": "" },
            { "index": 3, "label": "body", "defaultValue": "" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.require",
          "languageId": "lua",
          "label": "require",
          "description": "Module import",
          "triggerContexts": ["toplevel"],
          "insertText": "local ${1:name} = require('${2:module}')",
          "placeholders": [
            { "index": 1, "label": "alias", "defaultValue": "M" },
            { "index": 2, "label": "module", "defaultValue": "module.name" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        },
        {
          "id": "lua.while",
          "languageId": "lua",
          "label": "while",
          "description": "While loop",
          "triggerContexts": ["block"],
          "insertText": "while ${1:condition} do\n  ${2:-- body}\nend",
          "placeholders": [
            { "index": 1, "label": "condition", "defaultValue": "true" },
            { "index": 2, "label": "body", "defaultValue": "" }
          ],
          "controllerFriendly": true,
          "safety": "safe"
        }
      ],
      "safety": {
        "allowRunByDefault": true,
        "requiresConfirmation": [],
        "blockedCommands": ["sudo", "rm -rf", "os.execute('rm"]
      }
    }
  ]
}
