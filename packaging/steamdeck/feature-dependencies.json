{
  "schemaVersion": "1.0.0",
  "features": {
    "agents": {
      "dependencies": ["rust-sidecar", "model-runtimes"],
      "runtimeChecks": ["runtime.bridge.health", "feature.models.warningOnly"],
      "installerNotes": ["AI agents require a configured provider or local fallback."],
      "validationRefs": ["validate-runtime.sh", "validate-installer.sh"]
    },
    "academy": {
      "dependencies": ["electron-runtime", "rust-sidecar"],
      "runtimeChecks": ["runtime.bridge.health"],
      "installerNotes": ["Academy content ships inside the desktop runtime bundle."],
      "validationRefs": ["validate-runtime.sh"]
    },
    "api-lab": {
      "dependencies": ["electron-runtime", "rust-sidecar"],
      "runtimeChecks": ["runtime.bridge.health"],
      "installerNotes": ["API Lab ships inside the desktop runtime bundle."],
      "validationRefs": ["validate-runtime.sh"]
    },
    "browser": {
      "dependencies": ["electron-runtime", "rust-sidecar", "steam-client", "proton"],
      "runtimeChecks": ["runtime.browser.storage", "proton.launch.attempted"],
      "installerNotes": ["Browser storage is validated post-install; Proton is secondary validation only."],
      "validationRefs": ["validate-runtime.sh", "validate-proton.sh"]
    },
    "browser-vpn": {
      "dependencies": ["electron-runtime", "vpn-tooling"],
      "runtimeChecks": ["feature.browser-vpn.warningOnly"],
      "installerNotes": ["Missing VPN tools degrade to warnings, not hard failures."],
      "validationRefs": ["validate-runtime.sh"]
    },
    "cache": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Cache path uses XDG cache."], "validationRefs": ["validate-runtime.sh"] },
    "canvas": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Canvas execution uses the sidecar bridge."], "validationRefs": ["validate-runtime.sh"] },
    "cli-maker": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["CLI maker ships in the renderer bundle."], "validationRefs": ["validate-runtime.sh"] },
    "diagnostics": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health", "runtime.paths.writable"], "installerNotes": ["Diagnostics reports are written under XDG state."], "validationRefs": ["collect-diagnostics.sh", "validate-runtime.sh"] },
    "docs": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.assets.present"], "installerNotes": ["Docs rely on packaged frontend assets."], "validationRefs": ["validate-runtime.sh"] },
    "execution": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Execution flows route through the sidecar."], "validationRefs": ["validate-runtime.sh"] },
    "exports": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Exports target XDG user-writable paths only."], "validationRefs": ["validate-runtime.sh"] },
    "fonts": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.assets.present"], "installerNotes": ["Fonts are bundled in frontend assets."], "validationRefs": ["validate-runtime.sh"] },
    "git": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Git automation remains user-space only."], "validationRefs": ["validate-runtime.sh"] },
    "graph": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.assets.present"], "installerNotes": ["Graph view is renderer-only."], "validationRefs": ["validate-runtime.sh"] },
    "ide": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["IDE depends on PTY and bridge services."], "validationRefs": ["validate-runtime.sh"] },
    "maintenance": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Maintenance tools write only to XDG paths."], "validationRefs": ["repair.sh", "validate-runtime.sh"] },
    "mcp": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["MCP integration routes through the sidecar bridge."], "validationRefs": ["validate-runtime.sh"] },
    "memory": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Vector memory relies on the packaged sidecar."], "validationRefs": ["validate-runtime.sh"] },
    "models": { "dependencies": ["electron-runtime", "rust-sidecar", "model-runtimes"], "runtimeChecks": ["feature.models.warningOnly"], "installerNotes": ["Provider credentials are optional for install, required for live model calls."], "validationRefs": ["validate-runtime.sh"] },
    "orchestrator": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Orchestrator depends on bridge health."], "validationRefs": ["validate-runtime.sh"] },
    "plugins": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.plugins.writable", "runtime.plugins.present"], "installerNotes": ["Plugin directory must exist and invalid plugins must not crash startup."], "validationRefs": ["validate-runtime.sh"] },
    "project": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Project data persists under XDG data."], "validationRefs": ["validate-runtime.sh"] },
    "prompt-lab": { "dependencies": ["electron-runtime", "model-runtimes"], "runtimeChecks": ["feature.models.warningOnly"], "installerNotes": ["Prompt lab self-test passes without live credentials but reports warnings."], "validationRefs": ["validate-runtime.sh"] },
    "recovery": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Recovery uses local state and logs only."], "validationRefs": ["repair.sh", "collect-diagnostics.sh"] },
    "remote": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Remote control is available when sidecar bridge is healthy."], "validationRefs": ["validate-runtime.sh"] },
    "scheduler": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Scheduler state persists locally."], "validationRefs": ["validate-runtime.sh"] },
    "security": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Security data and support bundles are local-only."], "validationRefs": ["collect-diagnostics.sh", "validate-runtime.sh"] },
    "sessions": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Sessions persist under XDG data."], "validationRefs": ["validate-runtime.sh"] },
    "settings": { "dependencies": ["electron-runtime", "gamescope"], "runtimeChecks": ["launch.gamemode.defaultResolution"], "installerNotes": ["Settings surfaces runtime manifest and Game Mode state."], "validationRefs": ["validate-game-mode.sh", "validate-runtime.sh"] },
    "share": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Share exports remain local."], "validationRefs": ["validate-runtime.sh"] },
    "ssh": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["SSH profiles use XDG config/data."], "validationRefs": ["validate-runtime.sh"] },
    "sync": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Sync state persists under XDG data and requires the bridge."], "validationRefs": ["validate-runtime.sh"] },
    "terminal": { "dependencies": ["electron-runtime", "rust-sidecar", "gamescope", "steam-client", "proton"], "runtimeChecks": ["runtime.bridge.health", "launch.gamemode.defaultResolution", "proton.launch.attempted"], "installerNotes": ["Terminal smoke test must pass after install."], "validationRefs": ["validate-runtime.sh", "validate-game-mode.sh", "validate-proton.sh"] },
    "themes": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.themeAssets.present"], "installerNotes": ["Theme assets must ship with the frontend bundle."], "validationRefs": ["validate-runtime.sh"] },
    "torrent": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Torrent UI requires local storage only."], "validationRefs": ["validate-runtime.sh"] },
    "tunnel": { "dependencies": ["electron-runtime", "rust-sidecar"], "runtimeChecks": ["runtime.bridge.health"], "installerNotes": ["Tunnel services rely on the bridge sidecar."], "validationRefs": ["validate-runtime.sh"] },
    "wallpapers": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.assets.present"], "installerNotes": ["Wallpaper assets ship in bundled resources."], "validationRefs": ["validate-runtime.sh"] },
    "workspace": { "dependencies": ["electron-runtime"], "runtimeChecks": ["runtime.paths.writable"], "installerNotes": ["Workspace data stays inside user directories."], "validationRefs": ["validate-runtime.sh"] }
  }
}
