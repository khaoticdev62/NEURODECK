{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deckcode-multilang-code-entry.profile.json",
  "name": "DeckCode Multi-Language Code Entry Profile",
  "version": "1.0.0",
  "target": "steamdeck.coding.fullspec.v1",
  "purpose": "Language-aware Steam Deck mapping schema for fast code entry, snippets, paired symbols, statements, blocks, imports, tests, docs, and predictive insertions across multiple programming languages.",
  "base_physical_layers": {
    "L4": "nav_ctrl_layer",
    "L5": "symbol_syntax_layer",
    "R4": "selection_transform_layer",
    "R5": "language_ai_prediction_layer",
    "left_trackpad": "language_command_palette_16",
    "right_trackpad": "precision_pointer_caret",
    "LT": "selection_scope_axis",
    "RT": "accept_execute_axis"
  },
  "universal_entry_actions": {
    "paired_delimiters": {
      "L5+A": {
        "id": "insert.parens_pair",
        "text": "()",
        "cursor": "inside"
      },
      "L5+B": {
        "id": "insert.braces_pair",
        "text": "{}",
        "cursor": "inside"
      },
      "L5+X": {
        "id": "insert.brackets_pair",
        "text": "[]",
        "cursor": "inside"
      },
      "L5+Y": {
        "id": "insert.quotes_pair",
        "text": "\"\"",
        "cursor": "inside"
      },
      "L5+R2.soft": {
        "id": "insert.single_quotes_pair",
        "text": "''",
        "cursor": "inside"
      },
      "L5+R2.full": {
        "id": "insert.template_or_backtick",
        "text": "``",
        "cursor": "inside"
      }
    },
    "operators": {
      "L5+DPad.Left": {
        "id": "insert.less_than",
        "text": "<"
      },
      "L5+DPad.Right": {
        "id": "insert.greater_than",
        "text": ">"
      },
      "L5+DPad.Up": {
        "id": "insert.pipe_or_or",
        "text": "|"
      },
      "L5+DPad.Down": {
        "id": "insert.backtick_or_escape",
        "text": "`"
      },
      "L5+LB": {
        "id": "toggle.comment",
        "text": "language_comment"
      },
      "L5+RB": {
        "id": "insert.statement_end",
        "text": "language_statement_end"
      }
    },
    "entry_commit": {
      "RT.soft": "accept_completion_or_snippet_placeholder",
      "RT.full": "commit_current_line_or_run_safe_prediction",
      "A": "enter_or_confirm",
      "B": "escape_or_cancel",
      "X": "quick_fix_or_expand_snippet",
      "Y": "symbol_or_doc_search"
    }
  },
  "left_trackpad_language_palette": [
    {
      "slot": 0,
      "label": "Function",
      "emit": "entry.function"
    },
    {
      "slot": 1,
      "label": "Class/Type",
      "emit": "entry.type"
    },
    {
      "slot": 2,
      "label": "Condition",
      "emit": "entry.if_else"
    },
    {
      "slot": 3,
      "label": "Loop",
      "emit": "entry.loop"
    },
    {
      "slot": 4,
      "label": "Try/Catch",
      "emit": "entry.error_block"
    },
    {
      "slot": 5,
      "label": "Import",
      "emit": "entry.import"
    },
    {
      "slot": 6,
      "label": "Print/Log",
      "emit": "entry.log"
    },
    {
      "slot": 7,
      "label": "Return",
      "emit": "entry.return"
    },
    {
      "slot": 8,
      "label": "Test",
      "emit": "entry.test"
    },
    {
      "slot": 9,
      "label": "Doc",
      "emit": "entry.doc_comment"
    },
    {
      "slot": 10,
      "label": "Async",
      "emit": "entry.async"
    },
    {
      "slot": 11,
      "label": "Data",
      "emit": "entry.data_literal"
    },
    {
      "slot": 12,
      "label": "Interface",
      "emit": "entry.interface_or_protocol"
    },
    {
      "slot": 13,
      "label": "Module",
      "emit": "entry.module_package"
    },
    {
      "slot": 14,
      "label": "AI Fill",
      "emit": "ai.generate_from_context"
    },
    {
      "slot": 15,
      "label": "Lang Menu",
      "emit": "language.switch_or_settings"
    }
  ],
  "language_detection": {
    "priority": [
      "editor_language_id",
      "file_extension",
      "shebang",
      "nearest_config",
      "project_files",
      "manual_override"
    ],
    "manual_override_binding": "Menu.hold + left_trackpad.slot15",
    "fallback_language": "plain_text"
  },
  "language_packs": {
    "python": {
      "language_id": "python",
      "extensions": [
        ".py",
        ".pyw"
      ],
      "comment": "#",
      "statement_end": "",
      "symbol_overrides": {},
      "snippets": {
        "entry.function": {
          "template": "def ${name}(${params}):\n    ${cursor}",
          "placeholders": [
            "name",
            "params"
          ]
        },
        "entry.type": {
          "template": "class ${Name}:\n    def __init__(self${params}):\n        ${cursor}",
          "placeholders": [
            "Name",
            "params"
          ]
        },
        "entry.if_else": {
          "template": "if ${condition}:\n    ${cursor}\nelse:\n    pass"
        },
        "entry.loop": {
          "template": "for ${item} in ${items}:\n    ${cursor}"
        },
        "entry.error_block": {
          "template": "try:\n    ${cursor}\nexcept ${Exception} as e:\n    print(e)"
        },
        "entry.import": {
          "template": "import ${module}"
        },
        "entry.log": {
          "template": "print(${value})"
        },
        "entry.return": {
          "template": "return ${value}"
        },
        "entry.test": {
          "template": "def test_${behavior}():\n    ${cursor}"
        },
        "entry.doc_comment": {
          "template": "\"\"\"${description}\"\"\""
        },
        "entry.async": {
          "template": "async def ${name}(${params}):\n    ${cursor}"
        },
        "entry.data_literal": {
          "template": "{\"${key}\": ${value}}"
        },
        "entry.interface_or_protocol": {
          "template": "from typing import Protocol\n\nclass ${Name}(Protocol):\n    ${cursor}"
        },
        "entry.module_package": {
          "template": "if __name__ == \"__main__\":\n    ${cursor}"
        }
      },
      "prediction_rules": [
        {
          "when": "line.starts_with('def ') || cursor.in_function",
          "suggest": [
            "entry.return",
            "entry.doc_comment",
            "entry.test"
          ]
        },
        {
          "when": "diagnostic.name_error",
          "suggest": [
            "entry.import",
            "ai.fix_error"
          ]
        },
        {
          "when": "cursor.after_colon",
          "suggest": [
            "indent_block",
            "entry.log",
            "entry.return"
          ]
        }
      ]
    },
    "javascript": {
      "language_id": "javascript",
      "extensions": [
        ".js",
        ".mjs",
        ".cjs",
        ".jsx"
      ],
      "comment": "//",
      "statement_end": ";",
      "symbol_overrides": {
        "L5+R2.full": {
          "id": "insert.template_literal",
          "text": "`${cursor}`"
        }
      },
      "snippets": {
        "entry.function": {
          "template": "function ${name}(${params}) {\n  ${cursor}\n}"
        },
        "entry.type": {
          "template": "class ${Name} {\n  constructor(${params}) {\n    ${cursor}\n  }\n}"
        },
        "entry.if_else": {
          "template": "if (${condition}) {\n  ${cursor}\n} else {\n  \n}"
        },
        "entry.loop": {
          "template": "for (const ${item} of ${items}) {\n  ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "try {\n  ${cursor}\n} catch (error) {\n  console.error(error);\n}"
        },
        "entry.import": {
          "template": "import ${name} from \"${module}\";"
        },
        "entry.log": {
          "template": "console.log(${value});"
        },
        "entry.return": {
          "template": "return ${value};"
        },
        "entry.test": {
          "template": "test(\"${behavior}\", () => {\n  ${cursor}\n});"
        },
        "entry.doc_comment": {
          "template": "/**\n * ${description}\n */"
        },
        "entry.async": {
          "template": "async function ${name}(${params}) {\n  ${cursor}\n}"
        },
        "entry.data_literal": {
          "template": "{ ${key}: ${value} }"
        },
        "entry.interface_or_protocol": {
          "template": "// Use TypeScript interface in .ts files\nconst ${name} = ${value};"
        },
        "entry.module_package": {
          "template": "export default ${name};"
        }
      },
      "prediction_rules": [
        {
          "when": "file.extension == '.jsx'",
          "suggest": [
            "entry.component",
            "entry.import",
            "entry.log"
          ]
        },
        {
          "when": "diagnostic.missing_import",
          "suggest": [
            "entry.import",
            "ai.fix_error"
          ]
        }
      ]
    },
    "typescript": {
      "language_id": "typescript",
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "comment": "//",
      "statement_end": ";",
      "symbol_overrides": {
        "L5+DPad.Left": {
          "id": "insert.generic_open_or_less_than",
          "text": "<"
        },
        "L5+DPad.Right": {
          "id": "insert.generic_close_or_greater_than",
          "text": ">"
        }
      },
      "snippets": {
        "entry.function": {
          "template": "function ${name}(${params}): ${ReturnType} {\n  ${cursor}\n}"
        },
        "entry.type": {
          "template": "type ${Name} = {\n  ${field}: ${Type};\n};"
        },
        "entry.if_else": {
          "template": "if (${condition}) {\n  ${cursor}\n} else {\n  \n}"
        },
        "entry.loop": {
          "template": "for (const ${item} of ${items}) {\n  ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "try {\n  ${cursor}\n} catch (error) {\n  console.error(error);\n}"
        },
        "entry.import": {
          "template": "import { ${name} } from \"${module}\";"
        },
        "entry.log": {
          "template": "console.log(${value});"
        },
        "entry.return": {
          "template": "return ${value};"
        },
        "entry.test": {
          "template": "test(\"${behavior}\", () => {\n  ${cursor}\n});"
        },
        "entry.doc_comment": {
          "template": "/**\n * ${description}\n */"
        },
        "entry.async": {
          "template": "async function ${name}(${params}): Promise<${ReturnType}> {\n  ${cursor}\n}"
        },
        "entry.data_literal": {
          "template": "{ ${key}: ${value} }"
        },
        "entry.interface_or_protocol": {
          "template": "interface ${Name} {\n  ${field}: ${Type};\n}"
        },
        "entry.module_package": {
          "template": "export { ${name} };"
        }
      },
      "prediction_rules": []
    },
    "go": {
      "language_id": "go",
      "extensions": [
        ".go"
      ],
      "comment": "//",
      "statement_end": "",
      "symbol_overrides": {},
      "snippets": {
        "entry.function": {
          "template": "func ${name}(${params}) ${ReturnType} {\n\t${cursor}\n}"
        },
        "entry.type": {
          "template": "type ${Name} struct {\n\t${Field} ${Type}\n}"
        },
        "entry.if_else": {
          "template": "if ${condition} {\n\t${cursor}\n} else {\n\t\n}"
        },
        "entry.loop": {
          "template": "for ${condition} {\n\t${cursor}\n}"
        },
        "entry.error_block": {
          "template": "if err != nil {\n\treturn ${zero}, err\n}"
        },
        "entry.import": {
          "template": "import \"${module}\""
        },
        "entry.log": {
          "template": "fmt.Println(${value})"
        },
        "entry.return": {
          "template": "return ${value}"
        },
        "entry.test": {
          "template": "func Test${Behavior}(t *testing.T) {\n\t${cursor}\n}"
        },
        "entry.doc_comment": {
          "template": "// ${Name} ${description}"
        },
        "entry.async": {
          "template": "go func() {\n\t${cursor}\n}()"
        },
        "entry.data_literal": {
          "template": "${Type}{${Field}: ${value}}"
        },
        "entry.interface_or_protocol": {
          "template": "type ${Name} interface {\n\t${Method}(${params}) ${ReturnType}\n}"
        },
        "entry.module_package": {
          "template": "package ${name}"
        }
      },
      "prediction_rules": [
        {
          "when": "previous_token == 'err'",
          "suggest": [
            "entry.error_block"
          ]
        },
        {
          "when": "file.name.ends_with('_test.go')",
          "suggest": [
            "entry.test"
          ]
        }
      ]
    },
    "rust": {
      "language_id": "rust",
      "extensions": [
        ".rs"
      ],
      "comment": "//",
      "statement_end": "",
      "symbol_overrides": {
        "L5+Y": {
          "id": "insert.lifetime_or_quote_contextual",
          "text": "'"
        }
      },
      "snippets": {
        "entry.function": {
          "template": "fn ${name}(${params}) -> ${ReturnType} {\n    ${cursor}\n}"
        },
        "entry.type": {
          "template": "struct ${Name} {\n    ${field}: ${Type},\n}"
        },
        "entry.if_else": {
          "template": "if ${condition} {\n    ${cursor}\n} else {\n    \n}"
        },
        "entry.loop": {
          "template": "for ${item} in ${items} {\n    ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "match ${result} {\n    Ok(value) => value,\n    Err(err) => return Err(err),\n}"
        },
        "entry.import": {
          "template": "use ${module};"
        },
        "entry.log": {
          "template": "println!(\"{:?}\", ${value});"
        },
        "entry.return": {
          "template": "return ${value};"
        },
        "entry.test": {
          "template": "#[test]\nfn ${behavior}() {\n    ${cursor}\n}"
        },
        "entry.doc_comment": {
          "template": "/// ${description}"
        },
        "entry.async": {
          "template": "async fn ${name}(${params}) -> ${ReturnType} {\n    ${cursor}\n}"
        },
        "entry.data_literal": {
          "template": "${Name} { ${field}: ${value} }"
        },
        "entry.interface_or_protocol": {
          "template": "trait ${Name} {\n    fn ${method}(&self);\n}"
        },
        "entry.module_package": {
          "template": "mod ${name};"
        }
      },
      "prediction_rules": [
        {
          "when": "diagnostic.borrow_checker",
          "suggest": [
            "ai.explain_error",
            "entry.clone_or_ref",
            "entry.match"
          ]
        },
        {
          "when": "cursor.after_result",
          "suggest": [
            "insert.question_mark",
            "entry.error_block"
          ]
        }
      ]
    },
    "csharp": {
      "language_id": "csharp",
      "extensions": [
        ".cs"
      ],
      "comment": "//",
      "statement_end": ";",
      "symbol_overrides": {},
      "snippets": {
        "entry.function": {
          "template": "public ${ReturnType} ${Name}(${params})\n{\n    ${cursor}\n}"
        },
        "entry.type": {
          "template": "public class ${Name}\n{\n    ${cursor}\n}"
        },
        "entry.if_else": {
          "template": "if (${condition})\n{\n    ${cursor}\n}\nelse\n{\n    \n}"
        },
        "entry.loop": {
          "template": "foreach (var ${item} in ${items})\n{\n    ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "try\n{\n    ${cursor}\n}\ncatch (Exception ex)\n{\n    Console.WriteLine(ex);\n}"
        },
        "entry.import": {
          "template": "using ${Namespace};"
        },
        "entry.log": {
          "template": "Console.WriteLine(${value});"
        },
        "entry.return": {
          "template": "return ${value};"
        },
        "entry.test": {
          "template": "[Fact]\npublic void ${Behavior}()\n{\n    ${cursor}\n}"
        },
        "entry.doc_comment": {
          "template": "/// <summary>\n/// ${description}\n/// </summary>"
        },
        "entry.async": {
          "template": "public async Task<${ReturnType}> ${Name}Async(${params})\n{\n    ${cursor}\n}"
        },
        "entry.data_literal": {
          "template": "new ${Type} { ${Property} = ${value} }"
        },
        "entry.interface_or_protocol": {
          "template": "public interface I${Name}\n{\n    ${cursor}\n}"
        },
        "entry.module_package": {
          "template": "namespace ${Namespace};"
        }
      },
      "prediction_rules": []
    },
    "java": {
      "language_id": "java",
      "extensions": [
        ".java"
      ],
      "comment": "//",
      "statement_end": ";",
      "symbol_overrides": {},
      "snippets": {
        "entry.function": {
          "template": "public ${ReturnType} ${name}(${params}) {\n    ${cursor}\n}"
        },
        "entry.type": {
          "template": "public class ${Name} {\n    ${cursor}\n}"
        },
        "entry.if_else": {
          "template": "if (${condition}) {\n    ${cursor}\n} else {\n    \n}"
        },
        "entry.loop": {
          "template": "for (${Type} ${item} : ${items}) {\n    ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "try {\n    ${cursor}\n} catch (${Exception} e) {\n    e.printStackTrace();\n}"
        },
        "entry.import": {
          "template": "import ${package};"
        },
        "entry.log": {
          "template": "System.out.println(${value});"
        },
        "entry.return": {
          "template": "return ${value};"
        },
        "entry.test": {
          "template": "@Test\nvoid ${behavior}() {\n    ${cursor}\n}"
        },
        "entry.doc_comment": {
          "template": "/**\n * ${description}\n */"
        },
        "entry.async": {
          "template": "CompletableFuture<${ReturnType}> ${name}Async(${params}) {\n    ${cursor}\n}"
        },
        "entry.data_literal": {
          "template": "new ${Type}(${args})"
        },
        "entry.interface_or_protocol": {
          "template": "public interface ${Name} {\n    ${cursor}\n}"
        },
        "entry.module_package": {
          "template": "package ${packageName};"
        }
      },
      "prediction_rules": []
    },
    "cpp": {
      "language_id": "cpp",
      "extensions": [
        ".cpp",
        ".cc",
        ".cxx",
        ".hpp",
        ".h"
      ],
      "comment": "//",
      "statement_end": ";",
      "symbol_overrides": {},
      "snippets": {
        "entry.function": {
          "template": "${ReturnType} ${name}(${params}) {\n    ${cursor}\n}"
        },
        "entry.type": {
          "template": "struct ${Name} {\n    ${cursor}\n};"
        },
        "entry.if_else": {
          "template": "if (${condition}) {\n    ${cursor}\n} else {\n    \n}"
        },
        "entry.loop": {
          "template": "for (auto& ${item} : ${items}) {\n    ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "try {\n    ${cursor}\n} catch (const std::exception& e) {\n    std::cerr << e.what() << std::endl;\n}"
        },
        "entry.import": {
          "template": "#include <${header}>"
        },
        "entry.log": {
          "template": "std::cout << ${value} << std::endl;"
        },
        "entry.return": {
          "template": "return ${value};"
        },
        "entry.test": {
          "template": "TEST(${Suite}, ${Behavior}) {\n    ${cursor}\n}"
        },
        "entry.doc_comment": {
          "template": "/// ${description}"
        },
        "entry.async": {
          "template": "std::async([&]() {\n    ${cursor}\n});"
        },
        "entry.data_literal": {
          "template": "${Type}{${values}}"
        },
        "entry.interface_or_protocol": {
          "template": "class ${Name} {\npublic:\n    virtual ~${Name}() = default;\n    ${cursor}\n};"
        },
        "entry.module_package": {
          "template": "namespace ${Name} {\n${cursor}\n}"
        }
      },
      "prediction_rules": []
    },
    "html": {
      "language_id": "html",
      "extensions": [
        ".html",
        ".htm"
      ],
      "comment": "<!--",
      "statement_end": "",
      "symbol_overrides": {
        "L5+A": {
          "id": "insert.tag_pair",
          "text": "<${tag}>${cursor}</${tag}>"
        }
      },
      "snippets": {
        "entry.function": {
          "template": "<script>\nfunction ${name}(${params}) {\n  ${cursor}\n}\n</script>"
        },
        "entry.type": {
          "template": "<div class=\"${className}\">\n  ${cursor}\n</div>"
        },
        "entry.if_else": {
          "template": "<!-- conditional handled by framework/template engine -->\n${cursor}"
        },
        "entry.loop": {
          "template": "<!-- loop handled by framework/template engine -->\n${cursor}"
        },
        "entry.error_block": {
          "template": "<!-- error boundary/component placeholder -->\n${cursor}"
        },
        "entry.import": {
          "template": "<link rel=\"stylesheet\" href=\"${path}\">"
        },
        "entry.log": {
          "template": "<script>console.log(${value});</script>"
        },
        "entry.return": {
          "template": "${cursor}"
        },
        "entry.test": {
          "template": "<!-- test hook: data-testid=\"${id}\" -->"
        },
        "entry.doc_comment": {
          "template": "<!-- ${description} -->"
        },
        "entry.async": {
          "template": "<script type=\"module\">\nconst ${name} = async () => {\n  ${cursor}\n};\n</script>"
        },
        "entry.data_literal": {
          "template": "<${tag} ${attr}=\"${value}\">${cursor}</${tag}>"
        },
        "entry.interface_or_protocol": {
          "template": "<template id=\"${id}\">\n  ${cursor}\n</template>"
        },
        "entry.module_package": {
          "template": "<script type=\"module\" src=\"${path}\"></script>"
        }
      },
      "prediction_rules": []
    },
    "css": {
      "language_id": "css",
      "extensions": [
        ".css",
        ".scss",
        ".sass"
      ],
      "comment": "/*",
      "statement_end": "",
      "symbol_overrides": {},
      "snippets": {
        "entry.function": {
          "template": "@function ${name}(${params}) {\n  ${cursor}\n}"
        },
        "entry.type": {
          "template": ".${className} {\n  ${cursor}\n}"
        },
        "entry.if_else": {
          "template": "@media (${condition}) {\n  ${cursor}\n}"
        },
        "entry.loop": {
          "template": "@for $i from 1 through ${count} {\n  ${cursor}\n}"
        },
        "entry.error_block": {
          "template": "/* ${description} */"
        },
        "entry.import": {
          "template": "@import \"${path}\";"
        },
        "entry.log": {
          "template": "/* debug: ${value} */"
        },
        "entry.return": {
          "template": "${property}: ${value};"
        },
        "entry.test": {
