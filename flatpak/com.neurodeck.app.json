{
  "app-id": "com.neurodeck.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node20"
  ],
  "command": "neurodeck",
  "separate-locales": false,

  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node20/bin",
    "env": {
      "CARGO_HOME": "/run/build/neurodeck/cargo",
      "CARGO_NET_OFFLINE": "true",
      "npm_config_cache": "/run/build/neurodeck/npm-cache",
      "npm_config_nodedir": "/usr/lib/sdk/node20"
    }
  },

  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=all",
    "--filesystem=home",
    "--filesystem=xdg-config/neurodeck:create",
    "--filesystem=xdg-data/neurodeck:create",
    "--filesystem=xdg-cache/neurodeck:create",
    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1",
    "--env=WEBKIT_DISABLE_COMPOSITING_MODE=1",
    "--env=WEBKIT_FORCE_SANDBOX=0",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.portal.FileChooser"
  ],

  "modules": [
    {
      "name": "neurodeck",
      "buildsystem": "simple",
      "build-commands": [
        "npm install --prefix frontend --no-audit --no-fund",
        "npm run --prefix frontend build",
        "cargo build --release --manifest-path src-tauri/Cargo.toml",
        "install -Dm755 src-tauri/target/release/app /app/bin/neurodeck",
        "install -Dm644 src-tauri/llm-term.toml /app/share/neurodeck/llm-term.toml",
        "cp -r plugins /app/share/neurodeck/plugins 2>/dev/null || true",
        "cp -r _bmad /app/share/neurodeck/_bmad 2>/dev/null || true",
        "cp -r .agents /app/share/neurodeck/.agents 2>/dev/null || true",
        "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/com.neurodeck.app.png",
        "install -Dm644 src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/com.neurodeck.app.png",
        "install -Dm644 flatpak/com.neurodeck.app.desktop /app/share/applications/com.neurodeck.app.desktop",
        "install -Dm644 flatpak/com.neurodeck.app.metainfo.xml /app/share/metainfo/com.neurodeck.app.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            "frontend/node_modules",
            "frontend/dist",
            ".git",
            "*.flatpak",
            "neurodeck_win_release.zip",
            "neurodeck_installer.exe",
            "neurodeck-win-release"
          ]
        },
        {
          "type": "generated",
          "path": "flatpak/cargo-sources.json"
        }
      ]
    }
  ]
}
