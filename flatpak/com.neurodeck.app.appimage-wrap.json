{
  "app-id": "com.neurodeck.app",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "neurodeck",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--device=all",
    "--filesystem=home",
    "--filesystem=xdg-config/neurodeck:create",
    "--filesystem=xdg-data/neurodeck:create",
    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1",
    "--env=WEBKIT_DISABLE_COMPOSITING_MODE=1",
    "--env=WEBKIT_FORCE_SANDBOX=0",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.portal.FileChooser"
  ],
  "modules": [
    {
      "name": "neurodeck",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin /app/share/icons /app/share/metainfo /app/share/applications /app/share/licenses/neurodeck",
        "chmod +x neurodeck.AppImage",
        "./neurodeck.AppImage --appimage-extract",
        "# Find and install the binary (check multiple locations)",
        "if [ -f squashfs-root/usr/bin/neurodeck ]; then",
        "  install -Dm755 squashfs-root/usr/bin/neurodeck /app/bin/neurodeck",
        "elif [ -f squashfs-root/usr/bin/app ]; then",
        "  install -Dm755 squashfs-root/usr/bin/app /app/bin/neurodeck",
        "elif [ -f squashfs-root/AppRun ]; then",
        "  install -Dm755 squashfs-root/AppRun /app/bin/neurodeck",
        "else",
        "  find squashfs-root -type f -executable ! -path '*/.*' -name '*neurodeck*' -o -name 'app' -o -name 'AppRun' | head -1 | xargs -I {} install -Dm755 {} /app/bin/neurodeck",
        "fi",
        "# Install desktop file",
        "if [ -f squashfs-root/usr/share/applications/neurodeck.desktop ]; then",
        "  install -Dm644 squashfs-root/usr/share/applications/neurodeck.desktop /app/share/applications/com.neurodeck.app.desktop",
        "fi",
        "# Install metainfo",
        "if [ -f squashfs-root/usr/share/metainfo/com.neurodeck.app.metainfo.xml ]; then",
        "  install -Dm644 squashfs-root/usr/share/metainfo/com.neurodeck.app.metainfo.xml /app/share/metainfo/com.neurodeck.app.metainfo.xml",
        "fi",
        "# Install icons",
        "find squashfs-root/usr/share/icons/hicolor -type f -name 'neurodeck.png' -o -name 'app.png' | while read icon; do",
        "  destdir=$(echo $icon | sed 's|squashfs-root/usr/share/icons|/app/share/icons|')",
        "  mkdir -p $(dirname \"$destdir\")",
        "  install -Dm644 \"$icon\" \"$destdir\"",
        "done",
        "# Install license",
        "[ -f squashfs-root/LICENSE ] && install -Dm644 squashfs-root/LICENSE /app/share/licenses/neurodeck/LICENSE || echo 'Proprietary' > /app/share/licenses/neurodeck/LICENSE"
      ],
      "sources": [
        {
          "type": "file",
          "path": "neurodeck.AppImage",
          "dest": "."
        }
      ]
    }
  ]
}
