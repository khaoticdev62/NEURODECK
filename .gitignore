
# =============================================================================
# NEURODECK — .gitignore
# =============================================================================

# --- Rust / Cargo ---
target/
**/*.rs.bk

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
e2e/node_modules/
frontend/dist/
frontend/.vite/

# --- Build artifacts & binaries ---
dist-electron/
electron/dist-electron/
neurodeck
neurodeck_rc.zip
neurodeck_win_release.zip
*.exe
*.msi
*.AppImage
.package-lock.hash

# --- Test screenshots & temporary output ---
test-*.png
*.bak
src-tauri/data/logs/
e2e/playwright-report/
e2e/test-results/

# --- TypeScript build cache ---
*.tsbuildinfo

# --- Local tool state ---
.claude/settings.local.json
.playwright-mcp/
.serena/
scratch/

# --- Python / UV ---
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
dist/
*.egg-info/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- KFMS loose zone — only .gitkeep tracked; all other artifacts excluded ---
.loose/*
!.loose/
!.loose/inbox/
.loose/inbox/*
!.loose/inbox/.gitkeep
scripts/.loose/
.ruff_cache/
test-results/
