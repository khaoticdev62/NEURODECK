
# =============================================================================
# NEURODECK — .gitignore
# =============================================================================

# --- Rust / Cargo ---
target/
**/*.rs.bk

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
e2e/node_modules/
frontend/dist/
frontend/.vite/

# --- Build artifacts & binaries ---
neurodeck
neurodeck_rc.zip
neurodeck_win_release.zip
*.exe
*.msi

# --- Test screenshots & temporary output ---
test-*.png
*.bak
src-tauri/data/logs/

# --- Local tool state ---
.claude/settings.local.json
.playwright-mcp/
.serena/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- KFMS loose zone — reference materials tracked; compiled binaries excluded ---
.loose/*
!.loose/
!.loose/inbox/
!.loose/inbox/**
.loose/inbox/*.exe
.loose/inbox/*.msi
.loose/inbox/*.zip
.loose/inbox/neurodeck
.loose/inbox/kfms-release-logs/
.loose/inbox/security-hardening/
