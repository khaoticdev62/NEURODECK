#!/usr/bin/env bash
# KFMS post-commit hook
# Stamps meta.json with the just-committed SHA and amends silently.
# Guard prevents recursion when the amend itself triggers this hook.

[ "${KFMS_HOOK_RUNNING:-}" = "1" ] && exit 0
export KFMS_HOOK_RUNNING=1

ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$ROOT/scripts/khaotic-init.sh"

[ -x "$SCRIPT" ] || chmod +x "$SCRIPT"

echo "[KFMS] Stamping build block..."
bash "$SCRIPT" stamp

echo "[KFMS] Syncing derived artifacts..."
bash "$SCRIPT" sync

echo "[KFMS] Refreshing release plan..."
bash "$SCRIPT" release-plan -Json >/dev/null 2>&1 || true

# If KFMS-managed files changed, fold them into the commit via amend (no new commit created)
if ! git diff --quiet HEAD -- \
    infra/meta/meta.json \
    infra/telemetry/health.json \
    infra/meta/CODENAME_REGISTRY.md \
    docs/IMPLEMENTATION_PLAN.md 2>/dev/null; then
    git add \
        "$ROOT/infra/meta/meta.json" \
        "$ROOT/infra/telemetry/health.json" \
        "$ROOT/infra/meta/CODENAME_REGISTRY.md" \
        "$ROOT/docs/IMPLEMENTATION_PLAN.md"
    KFMS_HOOK_RUNNING=1 git commit --amend --no-edit --quiet
    echo "[KFMS] KFMS artifact amend applied."
fi

echo "[KFMS] Validating metadata..."
bash "$SCRIPT" validate

bash "$SCRIPT" status
