{
  "app-id": "org.neurodeck.Neurodeck",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "neurodeck",
  "modules": [
    {
      "name": "neurodeck",
      "buildsystem": "simple",
      "build-commands": [
        "install -D neurodeck /app/bin/neurodeck",
        "cp -r scripts /app/share/neurodeck/scripts",
        "cp -r plugins /app/share/neurodeck/plugins",
        "cp -r themes /app/share/neurodeck/themes",
        "mkdir -p /app/share/applications",
        "install -D org.neurodeck.Neurodeck.desktop /app/share/applications/org.neurodeck.Neurodeck.desktop",
        "install -D assets/icon.png /app/share/icons/hicolor/256x256/apps/org.neurodeck.Neurodeck.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ],
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0:ro",
    "--filesystem=host",
    "--device=all",
    "--talk-name=org.freedesktop.portal.Flatpak",
    "--talk-name=org.freedesktop.Notifications"
  ]
}
