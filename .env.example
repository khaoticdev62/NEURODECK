# =============================================================================
# NEURODECK Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Gemini API key for LLM chat, agent, and embedding features.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# LLM provider override: gemini | ollama | huggingface | kimi
# Defaults to gemini if GEMINI_API_KEY is set, otherwise falls back to ollama.
# LLM_PROVIDER=gemini

# Ollama base URL (only used when LLM_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434

# Google OAuth2 client ID for Gemini sign-in flow
# Register at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id_here

# -----------------------------------------------------------------------------
# Security / Development
# -----------------------------------------------------------------------------

# Bypass script execution blocklist (DANGEROUS — only for isolated dev)
# NEURODECK_ALLOW_UNSAFE_EXEC=1

# Tauri debug mode (enables source maps, disables minification)
# TAURI_DEBUG=1
